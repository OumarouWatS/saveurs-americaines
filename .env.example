# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRATION=24h

# Database
DB_PATH=./pastry.db

#Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

